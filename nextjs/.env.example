# Required. Issued in the bundle.social dashboard under Settings → API Keys.
BUNDLESOCIAL_API_KEY=

# Optional. If unset, the example will resolve the first team via
# bundlesocial.team.teamGetList({ limit: 1 }) at request time.
BUNDLESOCIAL_TEAM_ID=

# Required for /api/webhook. Use the secret shown in the dashboard
# alongside the webhook URL.
BUNDLESOCIAL_WEBHOOK_SECRET=
