# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# bundle.social API key — https://bundle.social/dashboard/organization/api-keys
BUNDLESOCIAL_API_KEY=sk_live_...

# Optional: default team id. Only needed if your org has more than one team.
# BUNDLESOCIAL_TEAM_ID=team_...

# Optional: override the bundle.social API base URL.
# BUNDLESOCIAL_API_URL=https://api.bundle.social
